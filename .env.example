DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nest API roots (use 127.0.0.1 on Windows — more reliable than localhost)
API_URL_LOCAL="http://127.0.0.1:3001/api/v1"
API_URL_LIVE="https://theauthenticapp-backend.onrender.com/api/v1"

# Dev default: hit local Nest only.
API_FORCE_LOCAL="true"
# Optional: allow silent fallback to Render when local is down
# API_ALLOW_LIVE_FALLBACK="true"
# API_FORCE_LIVE="true"

# Frontend treats this email as platform admin (Nest should also set SUPER_ADMIN).
PLATFORM_ADMIN_EMAIL="theauthentic.ng@gmail.com"

# WhatsApp floating button (E.164 digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"
# NEXT_PUBLIC_WHATSAPP_PREFILL="Hi AUTHENTIC — I need help."
